Mods: {
	deeprockitems: {
		Items: {
			BlankMatrixCore: {
				DisplayName: Blank Matrix Core
				Tooltip:
					'''
					Can be infused by Mission Control after completing a quest
					'If you want something done right, you do it yourself!'
					'''
				InfusedDisplayName: Infused Matrix Core: {0}
				InfusedTooltip: "'This overclock is going to be awesome!'"
				AppliesTo: Applies the following effects to the {0}:
			}

			JuryShotgun: {
				DisplayName: Jury-Rigged Boomstick
				Tooltip:
					'''
					Fires a spread of bullets
					'See ya, suckers!'
					'''
			}

			M1000: {
				DisplayName: M1000 Classic
				Tooltip:
					'''
					Shots can be charged by holding click
					'From A to D, skipping B and C!'
					'''
			}

			SludgePump: {
				DisplayName: Corrosive Sludge Pump
				Tooltip:
					'''
					Shots can be charged by holding click
					'It's a goo sack!'
					'''
			}

			PlasmaPistol: {
				DisplayName: Experimental Plasma Charger
				Tooltip:
					'''
					Hold click to fire a larger, slow moving projectile
					'I eat rock for breakfast!'
					'''
			}

			ChunkOfNitra: {
				DisplayName: Chunk Of Nitra
				Tooltip:
					'''
					Summons a pet M.U.L.E to store your items
					'We fight, for rock and stone!'
					'''
			}

			Zhukovs: {
				DisplayName: Zhukov NUK17
				Tooltip:
					'''
					Shoots a volley of 2 bullets
					'Eat lead!'
					'''
			}

			CryoCannon: {
				DisplayName: Cryo Cannon
				Tooltip:
					'''
					Shoots a stream of chilled mist that freezes enemies
					'Fueled up and raring to go!'
					'''
			}

			UpgradeStationItem: {
				DisplayName: Upgrade Station
				Tooltip: Used for upgrading dwarven equipment
			}
		}

		Misc: {
			UsefulWords: {
