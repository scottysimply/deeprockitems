Mods: {
	deeprockitems: {
		Items: {
			BlankMatrixCore: {
				DisplayName: Blank Matrix Core
				Tooltip:
					'''
					Can be infused by Mission Control after completing a quest
					'If you want something done right, you do it yourself!'
					'''
				InfusedDisplayName: Infused Matrix Core: {0}
				InfusedTooltip: "'This overclock is going to be awesome!'"
				AppliesTo: Applies the following effects to the {0}:
			}

			JuryShotgun: {
				DisplayName: Jury-Rigged Boomstick
				Tooltip:
					'''
					Fires a spread of bullets
					'See ya, suckers!'
					'''
			}

			M1000: {
				DisplayName: M1000 Classic
				Tooltip:
					'''
					Shots can be charged by holding click
					'From A to D, skipping B and C!'
					'''
			}

			SludgePump: {
				DisplayName: Corrosive Sludge Pump
				Tooltip:
					'''
					Shots can be charged by holding click
					'It's a goo sack!'
					'''
			}

			PlasmaPistol: {
				DisplayName: Experimental Plasma Charger
				Tooltip:
					'''
					Hold click to fire a larger, slow moving projectile
					'I eat rock for breakfast!'
					'''
			}

			ChunkOfNitra: {
				DisplayName: Chunk Of Nitra
				Tooltip:
					'''
					Summons a pet M.U.L.E to store your items
					'We fight, for rock and stone!'
					'''
			}

			Zhukovs: {
				DisplayName: Zhukov NUK17
				Tooltip:
					'''
					Shoots a volley of 2 bullets
					'Eat lead!'
					'''
			}

			CryoCannon: {
				DisplayName: Cryo Cannon
				Tooltip:
					'''
					Shoots a stream of chilled mist that freezes enemies
					'Fueled up and raring to go!'
					'''
			}

			UpgradeStationItem: {
				DisplayName: Upgrade Station
				Tooltip: Used for upgrading dwarven equipment
			}
		}

		Misc: {
			UsefulWords: {
				Recipe: Recipe:
				Upgradable: Upgradable at an Upgrade Station
				Overclocks: Overclocks
				Infuse: Infuse Matrix Core
				Equip: Equip
				Remove: Remove
			}
		}

		NPCs: {
			MissionControl: {
				DisplayName: Mission Control

				TownNPCMood: {
					// Neutral mood
					Content: This is fine. I'd say it beats the surface of Hoxxes.
					// Messages pertaining to housing
					NoHome: I'm a dwarf, not a troll! I'd like to stay somewhere that isn't under a bridge.
					FarFromHome: What did you do? I can't keep tabs on anything from here!
					// Messages regarding crowding
					LoveSpace: I love the alone time I get here.
					DislikeCrowded: I miss the days of having my operations to myself.
					HateCrowded: Get me out of here! I feel like a chicken surrounded by glyphids!
					// Biome messages
					LoveBiome: This place is excellent; it reminds me of the space rig.
					LikeBiome: "{BiomeName} really makes me feel at home."
					HateBiome: This sucks. I would demote you if I could.
					// NPC levels. All NPCs are disliked with a few exceptions
					// Tax collector and goblin
					LoveNPC: Me and {NPCName} see eye to eye.
					// Steampunker
					LikeNPC: I wish I could get {NPCName} to work with R&D...
					// Default
					DislikeNPC: "{NPCName} pries on me too much."
					HateNPC: Me and {NPCName} really don't get along.
					// This is Princess messages
					LikeNPC_Princess: Have you met {NPCName}? She's incredibly charismatic, even by my standards!
					Princess_LovesNPC: "{NPCName} may keep to himself, but he's a pretty stand-up guy!"
				}

				BestiaryText: Mission Control may be short, but he's also bald. He gives quests and allows for the infusing of matrix cores.
			}
		}

		Dialogue: {
			MissionControl: {
				StandardDialogue1: Hello {0}. Good to have you on the team.
				StandardDialogue2: I could really go for a cold brew right now.
				StandardDialogue3: Launch Control reports foreign objects in the launch tube. Would you happen to know anything about it?
				QuestOngoing1: You're not being paid by the hour. Get to work!
				QuestOngoing2: You might want to get a move on.
				QuestOngoing3: The clock is ticking, miner. Hurry up!
				QuestCompleted1: Congratulations, miner. You've earned yourself a break.
				QuestCompleted2: Thank you miner, this is just what R&D requested.
				QuestCompleted3: Alright miner, here's what we owe you.
				QuestInactive1: Unfortunately, we don't have any work for you yet. Check back tomorrow.
				QuestInactive2: No, you cannot bring barrels with you on the next mission.
				QuestInactive3: It breaks my heart to tell you, but R&D has no jobs available.
				// These next few keys are used for the quests. Format 0 is the name of what's required, 1 is how much is remaining.
				
				QuestStartMining1: Listen up, crew. I've got word that R&D is running low on resources. Mine {1} {0}, and report back!
				QuestStartMining2: Team, we're close to empty on {0}. Go mine {1} {0}, and you'll be given a reward in return.
				QuestStartGather1: Alright miners, R&D is requesting {1} {0}. Find some, bring it here, and you'll receive a bonus.
				QuestStartGather2: Expedition time, crew! We need you to set out and get {1} {0}, can you do that?
				QuestStartSlay1: Heads up from management: We've got an infestation! Go take down {1} {0} so we can continue our work. Good luck.
				QuestStartSlay2: I hope you're not tired of fighting; you're gonna need to kill {1} {0}. Report back here when you're done.
			}
		}

